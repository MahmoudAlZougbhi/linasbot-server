# Copy to .env and fill in values. This is the ONLY env file (no .env.local).
# Production: set APP_MODE=production via server environment (systemd/docker), not in repo .env.

# --- APP_MODE (required) ---
# local     = run locally; same APIs as production; real WhatsApp only to LOCAL_ALLOWED_WHATSAPP_NUMBERS (else dry-run).
# production = send normally. On server, set via environment so local .env edits don't affect prod.
APP_MODE=local

# --- When APP_MODE=local: sandbox numbers (comma-separated). Only these receive real WhatsApp. ---
LOCAL_ALLOWED_WHATSAPP_NUMBERS=+961XXXXXXXX,+961YYYYYYYY

# --- External API (calendar/CRM/customer – BOC / LinasLaser Agent) ---
# Runtime gate (default OFF). Keep false in production. See docs/requests/BOC_FUTURE_INTEGRATION.md
LINASLASER_BOC_BOOKING_ENABLED=false
LINASLASER_API_BASE_URL=https://boc-lb.com/agent/
LINASLASER_API_TOKEN=your_api_token_here
# Or: EXTERNAL_API_BASE_URL=... and EXTERNAL_API_TOKEN=...
# When LINASLASER_BOC_BOOKING_ENABLED is false, the app makes zero BOC HTTP calls
# and /api/ready does not require BOC token or booking IDs.

# --- WhatsApp providers ---
# Product path is Meta Cloud API (see META_* / WhatsApp Cloud sections below).
# MontyMobile keys below are LEGACY isolation only — keep configured for Monty-bound
# numbers until Mahmoud approves cutover. Do NOT remove these keys.
MONTYMOBILE_API_KEY=your_key
MONTYMOBILE_TENANT_ID=your_tenant_id
MONTYMOBILE_API_ID=your_api_id
MONTYMOBILE_SOURCE_NUMBER=961XXXXXXXX

# --- Persistent Data (IMPORTANT - survives deploy/rebuild) ---
# All data (Knowledge, Style, Price, FAQ, Smart Messaging, Activity Flow) lives here.
# Production: /opt/linasbot_data (ensure dir exists and app user has rwx)
# Dev: override with ./linasbot_data or any writable path outside project
# If not set: defaults to /opt/linasbot_data
LINASBOT_DATA_ROOT=/opt/linasbot_data

# --- Mobile app marketing version (server-side update gate) ---
# Compares expo.version only — iOS buildNumber / Android versionCode stay on EAS remote autoIncrement.
# MOBILE_APP_LATEST_VERSION=1.0.0
# MOBILE_APP_MIN_SUPPORTED_VERSION=1.0.0
# MOBILE_APP_IOS_STORE_URL=https://apps.apple.com/app/id6799678918
# MOBILE_APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.linasai.app

# --- Optional ---
# PUBLIC_URL=https://your-domain.com  (REQUIRED for webhook – MontyMobile must POST to PUBLIC_URL/webhook)
# DEBUG_WEBHOOK_LOGGING=true  (see webhook hits in server logs when messages don't reach)
# OPENAI_API_KEY=...
# Guest sales chat model (default gpt-5.6-sol + reasoning_effort low; no tools; no canned fallback).
# LINAS_GUEST_MODEL=gpt-5.6-sol

# --- Customer Reply AI V2 (sole production engine for IG/FB DMs + comments) ---
# Retrieval = gpt-5.6-luna; Final answer/repair = gpt-5.6-terra + reasoning_effort medium.
# No Classic generative fallback. No CUSTOMER_REPLY_AI_V2 / _LIVE shadow switches.
# CUSTOMER_SEMANTIC_RETRIEVAL_ENABLED=true
# CUSTOMER_MEDIA_CONTEXT_ENABLED=true
# LINAS_CUSTOMER_RETRIEVAL_MODEL=gpt-5.6-luna
# LINAS_CUSTOMER_ANSWER_MODEL=gpt-5.6-terra
# LINAS_CUSTOMER_MODEL=gpt-5.6-terra
# MAX_CUSTOMER_RETRIEVAL_ROUNDS=2
# CUSTOMER_DM_CONTEXT_WINDOW_HOURS=3

# --- Linas AI model routing (binding Sol / Luna retrieval / Terra answer; no silent env override) ---
# Customer IG/FB DMs/comments final answer:
# LINAS_CM_ANSWER_MODEL=gpt-5.6-terra
# LINAS_MODEL_CUSTOMER_DM=gpt-5.6-terra
# LINAS_CUSTOMER_HV_MODEL=gpt-5.6-terra
# Customer retrieval (evidence selection only):
# LINAS_CUSTOMER_RETRIEVAL_MODEL=gpt-5.6-luna
# Owner Copilot / Content Manager / setup:
# LINAS_OWNER_MODEL=gpt-5.6-sol
# LINAS_OWNER_CM_MODEL=gpt-5.6-sol
# LINAS_MODEL_OWNER_CHAT=gpt-5.6-sol
# LINAS_MODEL_SETUP=gpt-5.6-sol
# LINAS_MODEL_CREATIVE=gpt-5.6-sol
# LINAS_CREATIVE_MODEL=gpt-5.6-sol
# LINAS_OWNER_HELP_MODEL=gpt-5.6-sol
# Logged-in Owner Copilot recent chat-history read window (tokens the model reads):
# LINAS_OWNER_RECENT_HISTORY_TOKENS=4000
# LINAS_OWNER_CONTEXT_BUDGET=6000
# LINAS_OWNER_MAX_OUTPUT_TOKENS=1200
# Image (strongest Images API) + Video (strongest Sora):
# LINAS_IMAGE_MODEL=gpt-image-2
# LINAS_IMAGE_PROVIDER=openai
# LINAS_VIDEO_MODEL=sora-2-pro
# LINAS_VIDEO_PROVIDER=openai
# LINAS_VIDEO_SECONDS=8
# LINAS_VIDEO_SIZE=1280x720
# FIRESTORE_SERVICE_ACCOUNT_KEY_PATH=data/firebase_data.json
# WHATSAPP_TO=...
# TRAINER_WHATSAPP_NUMBER=...

# --- Meta Instagram + Facebook (inbound DMs and comment replies) ---
# Facebook Login for Business connects Facebook Pages only. Instagram uses the
# Instagram API product inside the same top-level app, with its own product ID,
# secret, OAuth flow, verify token, and dedicated webhook below.
# Keep disabled until credentials, Page subscription
# (messages + messaging_postbacks + feed), direct-Instagram subscription
# (messages + messaging_postbacks + comments), and App Review are ready.
# Secrets/tokens stay environment-only — never commit real values.
# Inbound AI is Facebook Messenger + Instagram only. WhatsApp inbound webhooks do not invoke AI;
# WhatsApp numbers below are handoff destinations from social DMs only.
# Instagram API with Instagram Login (separate credential/signature domain).
# META_INSTAGRAM_LOGIN_APP_ID=1035856539045307
# META_INSTAGRAM_LOGIN_REDIRECT_URI=https://www.linasaibot.com/oauth/instagram/callback
# META_INSTAGRAM_LOGIN_APP_SECRET=
# META_INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
# META_INSTAGRAM_LOGIN_WEBHOOK_PATH=/webhook/instagram-login
# META_INSTAGRAM_LOGIN_REFRESH_LEAD_DAYS=7
# Set true only after the three Instagram product permissions receive the required access decision.
# META_INSTAGRAM_LOGIN_ADVANCED_ACCESS_APPROVED=false
# PUBLIC_URL=https://www.linasaibot.com
META_SOCIAL_MESSAGING_ENABLED=false
META_SOCIAL_ROLLBACK_ACTIVE=false
META_SOCIAL_NEW_APP_REQUIRED=false
META_MULTI_APP_REGISTRY_ENABLED=false
# Required (32+ characters) before enabling the multi-app registry.
# META_CREDENTIAL_ENCRYPTION_KEY=
# Meta asset registry persistence: postgres (default/SoT) | file (local/emergency) | dual (migration only)
# META_REGISTRY_BACKEND=postgres
# HA billing / entitlements / credit ledger: file (default) | postgres (after import + soak)
# LINAS_BILLING_BACKEND=file
# HA mobile refresh + email auth tokens: file (default) | postgres (after import + soak)
# LINAS_AUTH_TOKEN_BACKEND=file
META_APP_ID=
META_APP_SECRET=
# Canonical App-A aliases used by the registry/WhatsApp Cloud integration.
# Keep each alias equal to its corresponding legacy name during migration.
# META_APP_A_ID=2963733803971681
# META_APP_A_SECRET=
# META_APP_A_WEBHOOK_VERIFY_TOKEN=
# Must remain false until Meta grants the requested Advanced Access.
# META_APP_A_ADVANCED_ACCESS_APPROVED=false
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
# Terminal inbound payload redaction policy. The scheduled HA retention job must
# be deployed and prove a clean dry-run on both nodes before App Review.
# META_INBOUND_PAYLOAD_RETENTION_DAYS=30
# Stable identity of this HA node, and the complete comma-separated node set.
# Both values are required for authenticated Meta data-deletion callbacks.
# META_DELETION_NODE_ID=node01
# META_DELETION_REQUIRED_NODES=node01,node02
# Owner gate: set true on both nodes only after the DigitalOcean LB health check
# is confirmed to use /api/ready (not /api/health). Deploys fail closed otherwise.
# META_HA_LB_READY_HEALTHCHECK_APPROVED=false
# Must cover the LB unhealthy threshold/interval; accepted range is 30..300 seconds.
# META_HA_LB_DRAIN_SECONDS=45
# App A Facebook Login for Business — Facebook Connect / Manage Meta Access (Pages only).
# META_APP_A_FACEBOOK_LOGIN_CONFIG_ID=1369663304545819
# META_OAUTH_REDIRECT_URI=https://www.linasaibot.com/oauth/meta/callback
# WhatsApp Embedded Signup uses a separate config (do not reuse for Facebook Connect):
# META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=1430599348520127
DASHBOARD_AUTH_SECRET=
# Client IP for rate limits (behind nginx). Prefer X-Real-IP; never trust leftmost X-Forwarded-For.
# TRUSTED_PROXY_MODE=x-real-ip  (default) | direct
# TRUSTED_PROXY_MODE=x-real-ip

# --- SaaS auth email (password reset + email verification) ---
# Prefer Resend (transactional). SMTP remains available only when RESEND_API_KEY is unset.
# Production runtime: SENDING_ONLY key only (never Full Access / RESEND_API_KEY_FULL).
# RESEND_API_KEY=re_...   # SENDING_ONLY, domain-restricted to linasaibot.com
# RESEND_WEBHOOK_SECRET=whsec_...
# RESEND_FROM_EMAIL=no-reply@linasaibot.com
# RESEND_FROM_NAME=Linas AI
# RESEND_REPLY_TO=support@linasaibot.com
# Optional combined form (also accepted): RESEND_FROM=Linas AI <no-reply@linasaibot.com>
# Optional SMTP (dev / non-Resend environments):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@linasaibot.com
# SMTP_USE_TLS=true
# PUBLIC_URL=https://www.linasaibot.com
# MAIL_LOG_LINKS=false
# PASSWORD_RESET_TTL_SECONDS=3600
# EMAIL_VERIFY_TTL_SECONDS=172800
# EMAIL_CHANGE_TTL_SECONDS=86400

# --- Subscription gate exemption (app_access without paid plan) ---
# Explicit allowlist only — mirrors TOKEN_WALLET_UNLIMITED_TENANT_IDS.
# Default (unset): linas = Linas Laser founder clinic (reserved tenant_id).
# SaaS tenants stay gated. To change the set, set a comma-separated list
# (replaces the default; does not append). Example to keep only linas:
# SUBSCRIPTION_EXEMPT_TENANT_IDS=linas

# --- Prepaid token wallet ---
# Comma-separated tenant ids with unlimited AI (default: linas). New SaaS tenants are metered.
# TOKEN_WALLET_UNLIMITED_TENANT_IDS=linas
# TOKEN_WALLET_ADMIN_CREDIT_TENANT_IDS=linas
# Stripe Checkout (optional — leave unset until ready; no fake charges):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Customer-facing WhatsApp routing numbers (public business contacts).
# Tracked defaults live in services/social_contact_routing.py so deployment works
# even when these env vars are unset. Set a variable only to override a number.
# Canonical customer links are always https://wa.me/<digits> (not wa.link).
SOCIAL_WHATSAPP_BEIRUT_FEMALE=+96178847527
SOCIAL_WHATSAPP_ANTELIAS_FEMALE=+96170707354
SOCIAL_WHATSAPP_BEIRUT_MALE=+96171534928
SOCIAL_WHATSAPP_ANTELIAS_MALE=+96171226082
# Tattoo removal: Beirut only, all genders (same number as Beirut male today).
SOCIAL_WHATSAPP_TATTOO_REMOVAL=+96171534928

# --- Content Management durable ops flags (production EnvironmentFile .env only) ---
# Do NOT commit real production values. The reviewed HA transaction preserves these across both nodes.
# After Linas published CM cutover, production must keep:
# CM_DISABLE_LINAS_LEGACY_BRIDGE=true
# Emergency rollback (forces legacy for all tenants; separate from bridge disable):
# CM_EMERGENCY_FORCE_LEGACY=false
# CM_EMERGENCY_DISABLE_PUBLISH=false

# --- Durable Redis job queues (Phase 2) ---
# Reuse one Redis instance via URL — never hardcode host/password in code.
# Leave unset for local API-only (in-process/file queue; not production_ready).
# REDIS_URL=redis://127.0.0.1:6379/0
# LINAS_REDIS_URL=  (alias of REDIS_URL)
# Activate workers + hard readiness only when Redis is live:
# LINAS_REQUIRE_REDIS=true
# LINAS_ENABLE_DURABLE_QUEUES=true
# HA: fail-closed Redis claims (webhook dedupe, outbound dedupe, job locks, conv state).
# Auto-enabled when LINAS_REQUIRE_REDIS=true. Prep only — do not enable on prod until cutover.
# LINAS_FAIL_CLOSED_REDIS_CLAIMS=true
# LINAS_QUEUE_KEY_PREFIX=linas:q
# LINAS_QUEUE_CONCURRENCY_HIGH=8
# LINAS_QUEUE_CONCURRENCY_INTERACTIVE=4
# LINAS_QUEUE_CONCURRENCY_BACKGROUND=2
# LINAS_QUEUE_CONCURRENCY_EXPENSIVE=1
# LINAS_QUEUE_JOB_TIMEOUT_SECONDS=300
# LINAS_QUEUE_MAX_ATTEMPTS=5
# LINAS_QUEUE_TENANT_INFLIGHT=4

# --- Auth / mutation rate limits (shared Redis; see docs/RATE_LIMIT_REDIS.md) ---
# Production (ENVIRONMENT/ENV=production) defaults RATE_LIMIT_BACKEND=redis and
# fail-closes (503) when Redis URL is missing or Redis is unreachable — never
# silently falls back to file/memory. Local/dev default is file when unset.
# RATE_LIMIT_BACKEND=redis
# RATE_LIMIT_REDIS_URL=  (falls back to REDIS_URL / LINAS_REDIS_URL)
# RATE_LIMIT_KEY_PREFIX=linas:rl
# RATE_LIMIT_UNAVAILABLE_RETRY_AFTER=60

# --- Apple Sign in with Apple (separate from IAP keys — never mix) ---
# APPLE_TEAM_ID=55624L5UXL
# APPLE_BUNDLE_ID=com.linasai.app
# APPLE_SIGN_IN_KEY_ID=5FK9G38WRJ
# APPLE_SIGN_IN_PRIVATE_KEY_PATH=~/.linasai-secrets/apple/AuthKey_5FK9G38WRJ.p8
# --- Apple / Google IAP (names only — never invent secrets) ---
# APPLE_BUNDLE_ID=com.linasai.app
# APPLE_IAP_SHARED_SECRET=
# APPLE_IAP_ISSUER_ID=a3b052c7-c0ed-4935-8e2e-4b57946e1f6b
# APPLE_IAP_KEY_ID=8H9SZG552B
# APPLE_IAP_PRIVATE_KEY_PATH=~/.linasai-secrets/apple/SubscriptionKey_8H9SZG552B.p8
# APPLE_APP_STORE_KEY_ID=  (alias of APPLE_IAP_KEY_ID)
# APPLE_APP_STORE_ISSUER_ID=  (alias of APPLE_IAP_ISSUER_ID)
# APPLE_APP_STORE_PRIVATE_KEY_PATH=  (alias of APPLE_IAP_PRIVATE_KEY_PATH)
# GOOGLE_PLAY_PACKAGE_NAME=com.linasai.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# Comma-separated OAuth client IDs (Web + iOS + Android) accepted as Google ID token aud.
# Client IDs are public; never put a client secret in mobile/EAS/frontend.
# GOOGLE_OAUTH_CLIENT_IDS=WEB_CLIENT_ID.apps.googleusercontent.com,IOS_CLIENT_ID.apps.googleusercontent.com,ANDROID_CLIENT_ID.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=  (server-only; not required for mobile ID-token verify)
# LINAS_IAP_PRODUCT_MAP_JSON={"com.linasai.app.lite.monthly":"lite","com.linasai.app.starter.monthly":"starter","com.linasai.app.growth.monthly":"growth","com.linasai.app.pro.monthly":"pro","com.linasai.app.max.monthly":"max"}

# --- WhatsApp Cloud API + Embedded Signup v4 + Coexistence (App A only) ---
# Presence-only checklist — never commit real values.
# LINAS_WHATSAPP_DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/linas_whatsapp
# DATABASE_URL=  (accepted alias)
# LINAS_WHATSAPP_ALLOW_SQLITE=true  # tests only
# META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# META_WHATSAPP_OAUTH_REDIRECT_URI=
# META_WHATSAPP_EMBEDDED_SIGNUP_BRIDGE_URL=
# WHATSAPP_CLOUD_CONNECTION_UI_ENABLED=false
# WHATSAPP_CLOUD_WEBHOOK_SIDE_EFFECTS_ENABLED=false
# WHATSAPP_CLOUD_OUTBOUND_SENDS_ENABLED=false
# WHATSAPP_CLOUD_AI_REPLIES_ENABLED=false
# WHATSAPP_CLOUD_HISTORY_SYNC_ENABLED=false
# Phase 1: keep public OFF; grant pilot rows via Owner Portal / POST /api/whatsapp/cloud/pilot/grant
# WHATSAPP_CLOUD_REQUIRE_PILOT_ENTITLEMENT=true
# Phase 2 (after Meta approval) — one central config-only switch, no deploy/rebuild:
# WHATSAPP_CLOUD_PUBLIC_AVAILABILITY=false
# Temporary Meta App Review bind (platform_owner only; token via env — never commit):
# META_WHATSAPP_APP_REVIEW_BIND_TOKEN=
# META_WHATSAPP_APP_REVIEW_ALLOWED_WABA_IDS=
# Legacy Monty remains default-off for inbound AI; Cloud path never falls back to Monty.
