# Copy to .env and fill in values. This is the ONLY env file (no .env.local).
# Production: set APP_MODE=production via server environment (systemd/docker), not in repo .env.

# --- APP_MODE (required) ---
# local     = run locally; same APIs as production; real WhatsApp only to LOCAL_ALLOWED_WHATSAPP_NUMBERS (else dry-run).
# production = send normally. On server, set via environment so local .env edits don't affect prod.
APP_MODE=local

# --- When APP_MODE=local: sandbox numbers (comma-separated). Only these receive real WhatsApp. ---
LOCAL_ALLOWED_WHATSAPP_NUMBERS=+961XXXXXXXX,+961YYYYYYYY

# --- External API (calendar/CRM/customer – same as production) ---
LINASLASER_API_BASE_URL=https://boc-lb.com/agent/
LINASLASER_API_TOKEN=your_api_token_here
# Or: EXTERNAL_API_BASE_URL=... and EXTERNAL_API_TOKEN=...

# --- WhatsApp provider (e.g. MontyMobile) ---
MONTYMOBILE_API_KEY=your_key
MONTYMOBILE_TENANT_ID=your_tenant_id
MONTYMOBILE_API_ID=your_api_id
MONTYMOBILE_SOURCE_NUMBER=961XXXXXXXX

# --- Persistent Data (IMPORTANT - survives deploy/rebuild) ---
# All data (Knowledge, Style, Price, FAQ, Smart Messaging, Activity Flow) lives here.
# Production: /opt/linasbot_data (ensure dir exists and app user has rwx)
# Dev: override with ./linasbot_data or any writable path outside project
# If not set: defaults to /opt/linasbot_data
LINASBOT_DATA_ROOT=/opt/linasbot_data

# --- Optional ---
# PUBLIC_URL=https://your-domain.com  (REQUIRED for webhook – MontyMobile must POST to PUBLIC_URL/webhook)
# DEBUG_WEBHOOK_LOGGING=true  (see webhook hits in server logs when messages don't reach)
# OPENAI_API_KEY=...
# FIRESTORE_SERVICE_ACCOUNT_KEY_PATH=data/firebase_data.json
# WHATSAPP_TO=...
# TRAINER_WHATSAPP_NUMBER=...

# --- Meta Instagram + Facebook Messenger (inbound DMs) ---
# Keep disabled until the Meta app, webhook subscriptions, and App Review are ready.
# Secrets/tokens stay environment-only — never commit real values.
META_SOCIAL_MESSAGING_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0

# Customer-facing WhatsApp routing numbers (public business contacts).
# Tracked defaults live in services/social_contact_routing.py so deployment works
# even when these env vars are unset. Set a variable only to override a number.
# Canonical customer links are always https://wa.me/<digits> (not wa.link).
SOCIAL_WHATSAPP_BEIRUT_FEMALE=+96178847527
SOCIAL_WHATSAPP_ANTELIAS_FEMALE=+96170707354
SOCIAL_WHATSAPP_BEIRUT_MALE=+96171534928
SOCIAL_WHATSAPP_ANTELIAS_MALE=+96171226082
# Tattoo removal: Beirut only, all genders (same number as Beirut male today).
SOCIAL_WHATSAPP_TATTOO_REMOVAL=+96171534928
