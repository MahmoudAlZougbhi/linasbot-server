# Copy to .env and fill in values. This is the ONLY env file (no .env.local).
# Production: set APP_MODE=production via server environment (systemd/docker), not in repo .env.

# --- APP_MODE (required) ---
# local     = run locally; same APIs as production; real WhatsApp only to LOCAL_ALLOWED_WHATSAPP_NUMBERS (else dry-run).
# production = send normally. On server, set via environment so local .env edits don't affect prod.
APP_MODE=local

# --- When APP_MODE=local: sandbox numbers (comma-separated). Only these receive real WhatsApp. ---
LOCAL_ALLOWED_WHATSAPP_NUMBERS=+961XXXXXXXX,+961YYYYYYYY

# --- External API (calendar/CRM/customer – same as production) ---
LINASLASER_API_BASE_URL=https://boc-lb.com/agent/
LINASLASER_API_TOKEN=your_api_token_here
# Or: EXTERNAL_API_BASE_URL=... and EXTERNAL_API_TOKEN=...

# --- WhatsApp provider (e.g. MontyMobile) ---
MONTYMOBILE_API_KEY=your_key
MONTYMOBILE_TENANT_ID=your_tenant_id
MONTYMOBILE_API_ID=your_api_id
MONTYMOBILE_SOURCE_NUMBER=961XXXXXXXX

# --- Persistent Data (IMPORTANT - survives deploy/rebuild) ---
# All data (Knowledge, Style, Price, FAQ, Smart Messaging, Activity Flow) lives here.
# Production: /opt/linasbot_data (ensure dir exists and app user has rwx)
# Dev: override with ./linasbot_data or any writable path outside project
# If not set: defaults to /opt/linasbot_data
LINASBOT_DATA_ROOT=/opt/linasbot_data

# --- Optional ---
# PUBLIC_URL=https://your-domain.com  (REQUIRED for webhook – MontyMobile must POST to PUBLIC_URL/webhook)
# DEBUG_WEBHOOK_LOGGING=true  (see webhook hits in server logs when messages don't reach)
# OPENAI_API_KEY=...
# Guest sales chat model (no tools; fails honestly if the provider is down — no canned fallback).
# LINAS_GUEST_MODEL=gpt-5-mini
# FIRESTORE_SERVICE_ACCOUNT_KEY_PATH=data/firebase_data.json
# WHATSAPP_TO=...
# TRAINER_WHATSAPP_NUMBER=...

# --- Meta Instagram + Facebook Messenger (inbound DMs) ---
# Instagram API with Facebook Login (not Instagram Login / instagram_business_*).
# Keep disabled until credentials, Page subscription (messages + messaging_postbacks),
# and App Review are ready. Secrets/tokens stay environment-only — never commit real values.
# Inbound AI is Facebook Messenger + Instagram only. WhatsApp inbound webhooks do not invoke AI;
# WhatsApp numbers below are handoff destinations from social DMs only.
# Instagram API with Instagram Login (separate from Facebook Login for Business).
# META_INSTAGRAM_LOGIN_APP_ID=1035856539045307
# META_INSTAGRAM_LOGIN_REDIRECT_URI=https://www.linasaibot.com/oauth/instagram/callback
# META_INSTAGRAM_LOGIN_APP_SECRET=
# META_INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
# META_INSTAGRAM_LOGIN_WEBHOOK_PATH=/webhook/instagram-login
# META_INSTAGRAM_LOGIN_REFRESH_LEAD_DAYS=7
META_SOCIAL_MESSAGING_ENABLED=false
META_SOCIAL_ROLLBACK_ACTIVE=false
META_SOCIAL_NEW_APP_REQUIRED=false
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
# App A Facebook Login for Business (dashboard Connect Facebook / Instagram)
# META_APP_A_LOGIN_CONFIG_ID=
# META_OAUTH_REDIRECT_URI=https://www.linasaibot.com/oauth/meta/callback
DASHBOARD_AUTH_SECRET=

# --- SaaS auth email (password reset + email verification) ---
# Required for real delivery. Without SMTP, tokens are still issued/stored but
# mail_sent=false (set MAIL_LOG_LINKS=true only in local/dev to log links).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@linasaibot.com
# SMTP_USE_TLS=true
# PUBLIC_URL=https://www.linasaibot.com
# MAIL_LOG_LINKS=false
# PASSWORD_RESET_TTL_SECONDS=3600
# EMAIL_VERIFY_TTL_SECONDS=172800

# --- Prepaid token wallet ---
# Comma-separated tenant ids with unlimited AI (default: linas). New SaaS tenants are metered.
# TOKEN_WALLET_UNLIMITED_TENANT_IDS=linas
# TOKEN_WALLET_ADMIN_CREDIT_TENANT_IDS=linas
# Stripe Checkout (optional — leave unset until ready; no fake charges):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Customer-facing WhatsApp routing numbers (public business contacts).
# Tracked defaults live in services/social_contact_routing.py so deployment works
# even when these env vars are unset. Set a variable only to override a number.
# Canonical customer links are always https://wa.me/<digits> (not wa.link).
SOCIAL_WHATSAPP_BEIRUT_FEMALE=+96178847527
SOCIAL_WHATSAPP_ANTELIAS_FEMALE=+96170707354
SOCIAL_WHATSAPP_BEIRUT_MALE=+96171534928
SOCIAL_WHATSAPP_ANTELIAS_MALE=+96171226082
# Tattoo removal: Beirut only, all genders (same number as Beirut male today).
SOCIAL_WHATSAPP_TATTOO_REMOVAL=+96171534928

# --- Content Management durable ops flags (production EnvironmentFile .env only) ---
# Do NOT commit real production values. deploy.sh preserves these across dual .env paths.
# After Linas published CM cutover, production must keep:
# CM_DISABLE_LINAS_LEGACY_BRIDGE=true
# Emergency rollback (forces legacy for all tenants; separate from bridge disable):
# CM_EMERGENCY_FORCE_LEGACY=false
# CM_EMERGENCY_DISABLE_PUBLISH=false

# --- Durable Redis job queues (Phase 2) ---
# Reuse one Redis instance via URL — never hardcode host/password in code.
# Leave unset for local API-only (in-process/file queue; not production_ready).
# REDIS_URL=redis://127.0.0.1:6379/0
# LINAS_REDIS_URL=  (alias of REDIS_URL)
# Activate workers + hard readiness only when Redis is live:
# LINAS_REQUIRE_REDIS=true
# LINAS_ENABLE_DURABLE_QUEUES=true
# LINAS_QUEUE_KEY_PREFIX=linas:q
# LINAS_QUEUE_CONCURRENCY_HIGH=8
# LINAS_QUEUE_CONCURRENCY_INTERACTIVE=4
# LINAS_QUEUE_CONCURRENCY_BACKGROUND=2
# LINAS_QUEUE_CONCURRENCY_EXPENSIVE=1
# LINAS_QUEUE_JOB_TIMEOUT_SECONDS=300
# LINAS_QUEUE_MAX_ATTEMPTS=5
# LINAS_QUEUE_TENANT_INFLIGHT=4

# --- Apple / Google IAP (names only — never invent secrets) ---
# APPLE_BUNDLE_ID=com.linasai.app
# APPLE_IAP_SHARED_SECRET=
# APPLE_APP_STORE_KEY_ID=
# APPLE_APP_STORE_ISSUER_ID=
# APPLE_APP_STORE_PRIVATE_KEY_PATH=
# GOOGLE_PLAY_PACKAGE_NAME=com.linasai.app
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH=
# LINAS_IAP_PRODUCT_MAP_JSON={"com.linasai.app.starter.monthly":"starter","com.linasai.app.growth.monthly":"growth","com.linasai.app.pro.monthly":"pro","com.linasai.app.max.monthly":"max"}
