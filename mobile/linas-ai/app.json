{
  "expo": {
    "name": "Linas AI",
    "slug": "linas-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": [
      "linasai",
      "com.googleusercontent.apps.513717053157-sp9fa5fqpg2f7pj5evbtkeucon1v4mm1"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.linasai.app",
      "buildNumber": "23",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Linas AI uses the microphone so you can dictate messages in chat. Audio is sent to Linas servers for speech-to-text only.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "55624L5UXL"
    },
    "android": {
      "package": "com.linasai.app",
      "versionCode": 23,
      "adaptiveIcon": {
        "backgroundColor": "#0B3D34",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-audio",
        {
          "microphonePermission": "Linas AI uses the microphone so you can dictate messages in chat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Linas AI needs photo access so you can attach images in chat with Copilot."
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-native.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FBFAFA",
          "dark": {
            "image": "./assets/splash-native.png",
            "backgroundColor": "#FBFAFA"
          }
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "apiBaseUrl": "https://linasaibot.com",
      "googleWebClientId": "513717053157-bqn6moo5q15q4c54bnmcgct07hrn8e1g.apps.googleusercontent.com",
      "googleIosClientId": "513717053157-sp9fa5fqpg2f7pj5evbtkeucon1v4mm1.apps.googleusercontent.com",
      "googleAndroidClientId": "513717053157-gegscca3fjh5e3qthacbs5k5a7gelrhn.apps.googleusercontent.com",
      "eas": {
        "projectId": "d15fe78a-09df-4d7c-81a5-2b307956fddf"
      }
    },
    "owner": "mahmoudalzoughbi"
  }
}
